/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON                    "res\\Icon.ico"
IDR_MAINFRAME_BLOCKED   ICON                    "res\\IconBlocked.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUT DIALOGEX 0, 0, 215, 75
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About TouchFreeze"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,158,54,50,14
    LTEXT           "TouchFreeze 1.2.3\nCopyright (C) 2005-2026 Ivan Zhakov & Contributors",IDC_STATIC,38,15,160,24
    ICON            IDR_MAINFRAME,IDC_STATIC,10,15,20,20
END

IDD_MONITOR DIALOGEX 0, 0, 360, 240
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TouchFreeze Settings & Input Monitor"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Palm Rejection State & Real-time Metrics",IDC_STATIC,7,7,346,95
    LTEXT           "State Information...",IDC_TXT_DIAG_INFO,14,20,332,76
    GROUPBOX        "Right Drag Area (Drag on pad to set)",IDC_STATIC,7,105,170,105
    CONTROL         "",IDC_MONITOR_PREVIEW,"Static",SS_NOTIFY | SS_SUNKEN,14,118,156,86
    GROUPBOX        "Real-time Event Stream",IDC_STATIC,183,105,170,105
    LISTBOX         IDC_LOG_LIST,189,118,158,86,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON      "Disable Zone",IDC_BTN_DISABLE_ZONE,7,215,60,18
    PUSHBUTTON      "Clear Log",IDC_BTN_CLEAR_LOG,183,215,60,18
    DEFPUSHBUTTON   "Close",IDOK,293,215,60,18
END



/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,2,3,0
 PRODUCTVERSION 1,2,3,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "TouchFreeze Application"
            VALUE "FileVersion", "1.2.3.0"
            VALUE "InternalName", "TouchFreeze"
            VALUE "LegalCopyright", "Copyright (C) 2005 Ivan Zhakov"
            VALUE "OriginalFilename", "TouchFreeze.exe"
            VALUE "ProductName", "TouchFreeze"
            VALUE "ProductVersion", "1.2.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END


