/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MENU MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Auto Start",                    ID_AUTOSTART_ON
        MENUITEM "&Disable Auto Start",            ID_AUTOSTART_OFF
        MENUITEM SEPARATOR
        POPUP "&Block Time"
        BEGIN
            MENUITEM "Fast (300ms)",               ID_BLOCKTIME_SHORT
            MENUITEM "Normal (500ms)",             ID_BLOCKTIME_NORMAL
            MENUITEM "Slow (700ms)",               ID_BLOCKTIME_LONG
        END
        POPUP "&Palm Rejection"
        BEGIN
            MENUITEM "Allow &1-Finger Motion",     ID_ALLOW_SINGLE_FINGER
        END
        MENUITEM SEPARATOR
        MENUITEM "Touchpad &Settings / Monitor...", ID_MONITOR
        MENUITEM "&About TouchFreeze...",         ID_ABOUT
        MENUITEM "E&xit",                         ID_EXIT
    END
END

